# Agentgateway / Pocket ID native OIDC
# Copy to .env (ignored by Git) or set the same variables in Komodo.
# Replace placeholder values before activating the OIDC policy.

############################
# Container / Unraid
# Docker Compose pins the container user to nobody:users (99:100).
# PUID/PGID are intentionally not configurable.
############################
TZ=America/New_York
AGENTGATEWAY_DATA_DIR=/mnt/user/appdata/agentgateway

############################
# Traefik dashboard
############################
AGENTGATEWAY_DOMAIN=agentgateway.theblaskies.com

############################
# Pocket ID OIDC client
############################
# Pocket ID issuer URL. The issuer must match its OIDC discovery document.
ISSUER_URL=https://id.theblaskies.com

# Pocket ID -> OIDC Clients -> Agentgateway
UI_CLIENT_ID=REPLACE_WITH_POCKET_ID_CLIENT_ID
UI_CLIENT_SECRET=REPLACE_WITH_POCKET_ID_CLIENT_SECRET

# Register this exact URI as an allowed redirect URI in Pocket ID.
REDIRECT_URI=https://agentgateway.theblaskies.com/oauth/callback

# Generate with: openssl rand -hex 32
# Required by agentgateway when ui.policies.oidc is enabled.
# Exactly 64 hexadecimal characters, kept secret and stable across restarts.
OIDC_COOKIE_SECRET=REPLACE_WITH_64_CHARACTER_HEX_VALUE
