# Copy this file to .env alongside docker-compose.yaml, or enter these variables in Komodo.
# No credentials are required for the initial dashboard-only deployment.

# Container user (Unraid nobody:users)
PUID=99
PGID=100
TZ=America/New_York

# Traefik dashboard host; requires DNS that resolves to your Traefik instance.
AGENTGATEWAY_DOMAIN=agentgateway.theblaskies.com

# Persistent, writable application configuration and SQLite database.
AGENTGATEWAY_DATA_DIR=/mnt/user/appdata/agentgateway
