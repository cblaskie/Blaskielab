# ==============================================================================
# KARAKEEP (HOARDER) ENVIRONMENT CONFIGURATION
# ==============================================================================

# Your root or sub-domain for the proxy route
DOMAIN=theblaskies.com [cite: 5, 8]

# Base external URL for NextAuth callbacks (matches your Traefik router setup)
NEXTAUTH_URL=https://karakeep.theblaskies.com [cite: 4, 8]

# A secure, random string used to encrypt session tokens
# You can generate one via: openssl rand -hex 32
KARAKEEP_SECRET=your_long_random_session_secret_here [cite: 4, 6]

# A secure string for Meilisearch authentication 
# Must be at least 16 bytes (or a long random phrase)
MEILI_MASTER_KEY=your_secure_meili_master_key_here [cite: 4, 6]

# ==============================================================================
# AI CONFIGURATION (DISABLED)
# ==============================================================================
# To completely disable AI integration, leave these values commented out.
# Karakeep will function perfectly using standard search and manual tagging.

# OPENAI_API_KEY=
# OLLAMA_BASE_URL=
# INFERENCE_TEXT_MODEL=
# INFERENCE_IMAGE_MODEL=
