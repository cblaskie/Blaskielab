# ==========================================
# 1. APPLICATION (GRIMMORY) SETTINGS
# ==========================================
# Durham, NC Timezone
TZ=America/New_York

# Unraid User/Group (Standard 99:100)
APP_USER_ID=99
APP_GROUP_ID=100

# Web Interface Port
BOOKLORE_PORT=8000

# Optional Settings
API_DOCS_ENABLED=false
DISK_TYPE=LOCAL

# ==========================================
# 2. DATABASE CONNECTIVITY
# ==========================================
# IMPORTANT: Hostname must match your standalone MariaDB container name
# Protocol MUST be 'jdbc:mariadb://' for Grimmory
DATABASE_URL=jdbc:mariadb://grimmory-db:3306/grimmory

# MariaDB User Credentials (must match MariaDB stack)
DB_USER=grimmory_user
DB_PASSWORD=ChangeMe_ApplicationUserPass_2026

# ==========================================
# 3. MARIADB STANDALONE SETTINGS
# ==========================================
# Required for the database container to initialize correctly
DB_USER_ID=99
DB_GROUP_ID=100

# Initial DB Creation
MYSQL_DATABASE=grimmory

# Database Passwords
MYSQL_ROOT_PASSWORD=ChangeMe_SuperSecureRoot_2026
