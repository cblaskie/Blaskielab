############################
# --- Provider / OIDC ---
############################
PROVIDER=generic
PROVIDER_GENERIC_ISSUER=https://id.yourdomain.com
CLIENT_ID=your_pocketid_client_id_here
CLIENT_SECRET=your_pocketid_client_secret_here

############################
# --- Authentication Host ---
############################
# The dedicated subdomain Traefik uses to handle the auth handshake
AUTH_HOST=auth.yourdomain.com

############################
# --- Cookie / Session ---
############################
# Used to encrypt the cookie securely. 
# Generate a random string for this (e.g., using `openssl rand -hex 16`)
SECRET=your_random_cookie_encryption_secret_here

# Use the leading dot to share authentication across all subdomains for SSO
COOKIE_DOMAIN=.yourdomain.com
