{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":issueCreationErrorNotice"  // 🌟 ADDED: Tells Renovate to automatically open a GitHub Issue if an update fails validation/CI checks
  ],
  "timezone": "America/New_York",
  "dependencyDashboard": true,
  "fetchReleaseNotes": "always",
  
  "prConcurrentLimit": 20,
  "prHourlyLimit": 0,
  
  // BRANCH COMPRESSION & HYGIENE CONFIG
  "automergeType": "squash",
  "rebaseWhen": "behind-base-branch",
  "prCreation": "not-pending",    // Prevents making a generic PR until background validations run green
  
  "schedule": [
    "after 10pm",
    "before 5am"
  ],
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "All Homelab Minor/Patch Updates",
      "groupSlug": "all-homelab-minor-patch",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
