
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/New_York",
  "dependencyDashboard": true,
  "fetchChangeLogs": "always",

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "prCreation": "immediate",

  "schedule": [
    "* 22-23 * * 0",
    "* 0-4 * * 1"
  ],

  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "Homelab Routine Updates",
      "groupSlug": "all-homelab-minor-patch",
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
