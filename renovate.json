{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/New_York",
  "dependencyDashboard": true,
  "fetchReleaseNotes": "always",
  
  "prConcurrentLimit": 20,
  "prHourlyLimit": 0,
  
  "schedule": [
    "after 10pm",
    "before 5am"
  ],
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      // 🌟 FIXED: Removed 'matchDatasources' constraint to bundle EVERYTHING minor/patch into one PR
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "All Homelab Minor/Patch Updates",
      "groupSlug": "all-homelab-minor-patch",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
